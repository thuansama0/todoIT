# Copy to .env for local dev / `eas build --local` (file .env is gitignored).
#
# EAS Build on expo.dev (cloud): add the SAME keys in Project → Environment variables:
#   - development  → profiles development, development:device
#   - preview      → profiles preview, preview:device
#   - production   → profile production
#
# Without EXPO_PUBLIC_API_URL on EAS, the installed APK cannot reach the API (login network error).

EXPO_PUBLIC_API_URL=https://your-api-domain.com/
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
